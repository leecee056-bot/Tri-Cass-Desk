{
  "name": "tri-cass-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Tri-Cass Desk — local-only living companion desktop",
  "main": "./out/main/index.js",
  "author": "Lee Cee",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "pack:win": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.6",
    "@fontsource/outfit": "^5.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.5.0",
    "file-type": "^22.3.0",
    "jszip": "^3.10.2",
    "marked": "^18.2.1",
    "mime-types": "^3.0.2",
    "monaco-editor": "^0.57.0",
    "papaparse": "^5.7.1",
    "plyr": "^3.8.5",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "systeminformation": "^5.25.11",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/mime-types": "^3.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.3"
  },
  "build": {
    "appId": "os.tricass.desk",
    "productName": "Tri-Cass Desk",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
