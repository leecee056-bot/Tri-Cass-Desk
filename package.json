{
  "name": "tri-cass-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Tri-Cass Desk — local-only living companion desktop",
  "main": "./out/main/index.js",
  "author": "Lee Cee",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "pack:win": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.6",
    "@fontsource/outfit": "^5.2.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "systeminformation": "^5.25.11"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.3"
  },
  "build": {
    "appId": "os.tricass.desk",
    "productName": "Tri-Cass Desk",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
