{
  "name": "tri-cass-desk",
  "version": "0.4.0",
  "private": false,
  "description": "Tri-Cass OS Desk \u2014 local-only living companion desktop",
  "main": "./out/main/index.js",
  "author": "Lee Cee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leecee056-bot/Tri-Cass-Desk.git"
  },
  "homepage": "https://github.com/leecee056-bot/Tri-Cass-Desk#readme",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "pack:win": "npm run build && electron-builder --win nsis portable --x64 --ia32",
    "pack:win:dir": "npm run build && electron-builder --win --dir",
    "pack:linux": "npm run build && electron-builder --linux AppImage deb --x64",
    "pack:linux:arm64": "npm run build && electron-builder --linux AppImage --arm64",
    "pack:all:ci": "electron-builder --publish never"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.6",
    "@fontsource/outfit": "^5.2.5",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.5.0",
    "file-type": "^22.3.0",
    "jszip": "^3.10.2",
    "marked": "^18.2.1",
    "mime-types": "^3.0.2",
    "monaco-editor": "^0.57.0",
    "papaparse": "^5.7.1",
    "plyr": "^3.8.5",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "systeminformation": "^5.25.11",
    "three": "^0.187.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/mime-types": "^3.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.187.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.3"
  },
  "build": {
    "appId": "os.tricass.desk",
    "productName": "Tri-Cass Desk",
    "copyright": "Copyright \u00a9 Tri-Cass OS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "icon": "build/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64", "ia32"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Tri-Cass-Desk-${version}-${os}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "artifactName": "Tri-Cass-Desk-${version}-${os}-${arch}.${ext}",
      "desktop": {
        "Name": "Tri-Cass Desk",
        "Comment": "Local-only living companion for Tri-Cass OS",
        "Categories": "Utility;Office;"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tri-Cass Desk",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Tri-Cass-Desk-${version}-${os}-${arch}-portable.${ext}"
    }
  }
}
